#!name=北之每日签到
#!desc=通过 Cookie 每日自动签到，支持多账号。首次使用请填写 Cookie，或启用 Cookie 捕获后按账号逐个打开个人中心。
#!author=Pi Agent
#!homepage=https://beizhi.sylu.cc/profile
#!arguments=定时时间:30 8 * * *,获取Cookie:true,定时任务:true,账号:账号1,Cookie:,通知:true,Cookie通知:true,策略:DIRECT
#!arguments-desc=Cookie 格式：账号1:::Cookie|||账号2:::Cookie；也可以启用 Cookie 捕获，设置账号名后打开一次个人中心。定时任务使用本地时区。

[Script]
{{{获取Cookie}}} = type=http-request,pattern=^https:\/\/beizhi\.sylu\.cc\/profile(?:[\/?#]|$),script-path=beizhi-checkin.js,timeout=15,argument="account={{{账号}}}&notify={{{Cookie通知}}}"
{{{定时任务}}} = type=cron,cronexp="{{{定时时间}}}",script-path=beizhi-checkin.js,timeout=60,wake-system=true,argument="cookies={{{Cookie}}}&notify={{{通知}}}&policy={{{策略}}}"

[MITM]
hostname = %APPEND% beizhi.sylu.cc
