#!name=北执每日签到
#!desc=通过 Cookie 每日自动签到（双账号并行）。在模块参数 Cookie1 / Cookie2 中填写账号 Cookie，格式：账号名:::Cookie，同名账号视为同一账号，后填写的 Cookie 覆盖先前。也可登录后在个人中心自动捕获 Cookie。
#!author=Pi Agent
#!homepage=https://beizhi.sylu.cc/profile
#!arguments=定时时间:30 8 * * *,定时任务:北执签到,获取Cookie:北执Cookie,MITM:hostname,账号:账号名,通知:true,Cookie通知:true,策略:DIRECT,Cookie1:Cookie1,Cookie2:Cookie2
#!arguments-desc=定时时间：Cron 表达式，默认每天 08:30 执行。\n\n定时任务：每日自动签到入口，输入 # 表示禁用。\n\n获取Cookie：自动捕获当前账号 Cookie（可选），输入 # 表示禁用。\n\nMITM：是否追加 beizhi.sylu.cc 到 MITM，输入 # 表示禁用。\n\n账号：捕获时使用的账号名称。\n\nCookie1 / Cookie2：两个账号的 Cookie，格式：账号名:::Cookie，或只填 Cookie。同名账号视为同一账号，重新填写会覆盖旧值。\n\n通知：true/false，控制每日签到通知。\n\nCookie通知：true/false，控制 Cookie 捕获通知。\n\n策略：请求策略，默认 DIRECT。\n
[Script]
# 自动捕获当前账号 Cookie（可选，双账号并行时可直接在 Cookie1 / Cookie2 参数填写）
{{{获取Cookie}}} = type=http-request,pattern=^https:\/\/beizhi\.sylu\.cc\/,script-path=https://raw.githubusercontent.com/Suk1u/Liminality/refs/heads/main/beizhi-checkin.js,script-update-interval=0,timeout=15,argument="account={{{账号}}}&notify={{{Cookie通知}}}",debug=true
# 每日计划任务，双账号并行签到
{{{定时任务}}} = type=cron,cronexp="{{{定时时间}}}",script-path=https://raw.githubusercontent.com/Suk1u/Liminality/refs/heads/main/beizhi-checkin.js,script-update-interval=0,timeout=60,wake-system=true,argument="notify={{{通知}}}&Cookie1={{{Cookie1}}}&Cookie2={{{Cookie2}}}&policy={{{策略}}}",debug=true

[MITM]
{{{MITM}}} = %APPEND% beizhi.sylu.cc